{
  "name": "dory",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"cross-env BROWSER=none npm start\" \"npm run electron:start\"",
    "lint": "eslint .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.dory.launcher",
    "productName": "Dory",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "image.png",
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}Portable.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "image.png"
    ],
    "extraResources": [
      {
        "from": "image.png",
        "to": "image.png"
      }
    ]
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  }
}
